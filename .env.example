NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Generate a unique random secret for each environment; never use this placeholder as-is.
JWT_SECRET=replace-with-a-long-random-secret
# Local development database example only. Set credentials in your local environment.
DATABASE_URL=postgresql://mpa:replace-with-local-password@127.0.0.1:5432/mpa

# Production authentication/session hardening
AUTH_SESSION_DAYS=7

# Optional one-time/controlled bootstrap of the first System Administrator.
# Set these only in a protected local/server environment; never commit actual credentials.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_LONG_RANDOM_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_LONG_RANDOM_PASSWORD
BOOTSTRAP_ADMIN_NAME="System Administrator"

# In production, set to the exact HTTPS origin(s) allowed for browser API access.
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Email verification and operations (configure a verified sender before production use)
PUBLIC_APP_URL=http://localhost:3001
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="MPA Network <verify@example.org>"
# Keep disabled until registration issuance and server-side enforcement are integrated and tested.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_URL=
